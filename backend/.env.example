# ---------------------------------------------------------------------------
# lease-abstraction-tool backend environment variables
# Copy this file to `.env` and fill in real values for your environment.
# Every variable below is read via python-decouple's config().
# ---------------------------------------------------------------------------

# Django core
SECRET_KEY=django-insecure-dev-only-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# --- USE_SQLITE toggle ---
# True  (default): backend runs on local SQLite (db.sqlite3) and every
#        Azure-backed service below runs in deterministic-stub mode -- no
#        network access, no cost, no real Azure resources needed. This is
#        what `manage.py test` and CI always run under.
# False: backend connects to real PostgreSQL using the POSTGRES_* values
#        below. Postgres is used purely as plain relational storage -- no
#        pgvector extension, no vector columns anywhere; vectors always go
#        through the Azure AI Search abstraction (search_store.py). Each
#        AZURE_* integration below independently stays stubbed even with
#        USE_SQLITE=False as long as its own env vars are left blank.
USE_SQLITE=True

# PostgreSQL (used only when USE_SQLITE=False). Local native Postgres,
# no extensions required.
POSTGRES_DB=lease_abstraction_tool
POSTGRES_USER=lease_abstraction_tool
POSTGRES_PASSWORD=lease_abstraction_tool
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Azure Blob Storage (apps/common/blob_store.py) ---
# Optional / stubbed. Leave blank to store uploaded lease documents on local
# disk under MEDIA_ROOT/blob_stub/ instead of real Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lease-documents

# --- Azure AI Document Intelligence (apps/common/document_intelligence.py) ---
# Optional / stubbed. Leave both blank to use a deterministic SHA256-seeded
# text-parsing stub instead of the real prebuilt-document model.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Azure OpenAI (apps/common/ai.py) ---
# Optional / stubbed. Leave both blank to use deterministic stub chat replies
# and SHA256-seeded stub embedding vectors instead of real Azure OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search (apps/common/search_store.py) ---
# Optional / stubbed. Leave both blank to use an in-process, in-memory
# cosine-similarity fallback (process-local, no persistence) instead of a
# real Azure AI Search index. This is the ONLY place vectors/embeddings are
# stored anywhere in this app -- never in Postgres.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_LEASE_CHUNKS=lease_chunks
