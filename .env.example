# Copy to .env and fill in real values before running docker compose.
# Full per-variable documentation lives in backend/.env.example - this file
# is the root-level copy docker-compose.yml reads via env_file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=True

# --- Database mode toggle ---
# True (default for local `manage.py` use) = SQLite + all Azure services
# stubbed. docker-compose overrides this to False so the backend container
# always talks to the `db` Postgres container instead.
USE_SQLITE=True

# --- Postgres (plain relational only - no pgvector extension needed) ---
POSTGRES_DB=lease_abstraction_tool
POSTGRES_USER=lease_abstraction_tool
POSTGRES_PASSWORD=lease_abstraction_tool
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Azure services - all optional, every one falls back to a deterministic
# local stub (no network, no cost) when left blank. See backend/.env.example
# for what each stub does. ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lease-documents

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_LEASE_CHUNKS=lease_chunks

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
